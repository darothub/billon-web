# Copy this file to .env and fill it in. Nothing here is secret; the real values are.
#
# Nothing in this file may be prefixed NEXT_PUBLIC_ — that prefix hands a setting to
# every visitor's browser, and every setting below is a server-side one.

# Where Billon keeps everything. The docker compose file in this project starts a
# PostgreSQL matching this line, so a fresh machine can use it as-is.
DATABASE_URL=postgresql://billon:billon@localhost:5432/billon

# Signs the sign-in tokens. Any long random string; use a different one per
# environment, so a token made on a laptop is refused by the live app.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# The shared secret the nightly overdue sweep is called with. On Vercel this is sent
# automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me-to-another-long-random-string

# The public address of this app, used to build the link in password reset emails.
APP_URL=http://localhost:3000

# Sending an invoice always moves it to sent. It additionally emails the client only
# when this is exactly 'true' AND the mail settings below are filled in. Leave it off
# until docs/JAVA-SERVICE-FINDINGS.md records that the old service emailed.
BILLON_SEND_EMAILS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=<password>
SMTP_FROM=

# Only needed to run the one-off data move out of the old Java database. Point it at a
# restored copy, never at the live one.
LEGACY_DATABASE_URL=
