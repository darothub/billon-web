{
  "name": "billon-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:rehearsal": "vitest run --project rehearsal",
    "test:release": "vitest run --project release",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "migrate:legacy": "tsx scripts/migrate/cli.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "16.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^6.3.0",
    "@react-pdf/renderer": "^4.3.0",
    "@tanstack/react-query": "^5.74.4",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "formidable": "^3.5.4",
    "jose": "^5.9.6",
    "js-cookie": "^3.0.5",
    "nodemailer": "^6.9.16",
    "zustand": "^5.0.3",
    "react-hook-form": "^7.55.0",
    "zod": "^3.24.2",
    "@heroicons/react": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.4.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pg": "^8.13.1",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "tailwindcss": "^4.1.3",
    "@tailwindcss/postcss": "^4.1.3"
  }
}
